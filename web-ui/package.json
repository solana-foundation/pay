{
  "name": "pay-web-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch api/index.ts\" \"vite\"",
    "dev:api": "tsx watch api/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc --noEmit && tsc -p api/tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx api/index.ts",
    "proxy": "tsx proxy/server.ts",
    "test:proxy": "tsx proxy/e2e.ts"
  },
  "dependencies": {
    "@solana/kit": "^6.10.0",
    "@solana/mpp": "^0.5.2",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "mppx": "^0.8.19",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "x402": "^1.2.0",
    "x402-express": "^1.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk@<1.31.0": "^1.31.0",
      "@walletconnect/ethereum-provider": "2.25.0",
      "axios@<1.18.0": "^1.18.0",
      "fast-uri@3.1.6": "^3.1.7",
      "qs@<6.16.0": "^6.16.0",
      "shell-quote@<1.11.0": "^1.11.0",
      "uuid@<11.1.1": "^11.1.1",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
